# ==============================================================================
# Variáveis de Ambiente — Bingo de Mesa
# ==============================================================================
# ATENÇÃO: NUNCA compartilhe secrets reais nem adicione prefixo NEXT_PUBLIC_!
# Essas chaves são estritamente server-side e não devem ser expostas ao client.

# Chave secreta de alta entropia para assinatura HMAC-SHA256 de cartelas BNG1S.
# Requisito obrigatório: mínimo de 32 caracteres.
# Se ausente, o modo local (BNG1U) continua funcionando e cartelas assinadas ficam desativadas.
BINGO_SIGNING_SECRET=

# Token do Bot do Telegram gerado via @BotFather (ex: 123456789:ABCdefGhIJKlmNoPQRstuvwxYZ).
# Necessário no servidor para validar o HMAC do initData do Telegram Mini Apps
# e associar de forma confiável a identidade do jogador à cartela emitida.
TELEGRAM_BOT_TOKEN=
